{
	"name": "StatusCheck",
	"author": [
		"WikiTeq"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:StatusCheck",
	"descriptionmsg": "statuscheck-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\StatusCheck\\": "src/"
	},
	"config_prefix": "wg",
	"config": {
		"StatusCheckEmailAddress": {
			"description": "Email address to test email sending",
			"value": null
		},
		"StatusCheckDefaultSet": {
			"description": "List of Checks classes to perfom by default",
			"value": [
				"MediaWiki\\Extension\\StatusCheck\\Checks\\ComposerDependenciesCheck",
				"MediaWiki\\Extension\\StatusCheck\\Checks\\EmailSendCheck",
				"MediaWiki\\Extension\\StatusCheck\\Checks\\FileUploadCheck",
				"MediaWiki\\Extension\\StatusCheck\\Checks\\StuckJobsCheck",
				"MediaWiki\\Extension\\StatusCheck\\Checks\\SearchCheck"
			]
		}
	},
	"ConfigRegistry": {
		"StatusCheck": "GlobalVarConfig::newInstance"
	},
	"SpecialPages": {
		"StatusCheck": "MediaWiki\\Extension\\StatusCheck\\SpecialStatusCheck"
	},
	"AvailableRights": [
		"status-check"
	],
	"APIModules": {
		"statuscheck": "MediaWiki\\Extension\\StatusCheck\\Api\\StatusCheckEndpoint"
	},
	"GroupPermissions": {
		"sysop": {
			"status-check": true
		}
	},
	"HookHandlers": {
		"StatusCheckHooks": {
			"class": "MediaWiki\\Extension\\StatusCheck\\Hooks"
		}
	},
	"Hooks": {
		"BeforePageDisplay": "StatusCheckHooks"
	},
	"MessagesDirs": {
		"StatusCheck": [
			"i18n"
		]
	},
	"ResourceModules": {
		"ext.statusCheck": {
			"localBasePath": "resources/ext.statusCheck",
			"remoteExtPath": "StatusCheck/resources/ext.statusCheck",
			"dependencies": [],
			"styles": [
				"init.css"
			],
			"packageFiles": [
				"init.js"
			],
			"messages": []
		}
	},
	"manifest_version": 2
}

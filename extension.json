{
	"name": "StatusCheck",
	"author": [
		"WikiTeq",
		"Daniel Scherzer"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:StatusCheck",
	"descriptionmsg": "statuscheck-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.43.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\StatusCheck\\": "src/"
	},
	"config_prefix": "wg",
	"config": {
		"StatusCheckEmailAddress": {
			"description": "Email address to test email sending",
			"value": null
		}
	},
	"SpecialPages": {
		"StatusCheck": {
			"class": "MediaWiki\\Extension\\StatusCheck\\SpecialStatusCheck",
			"services": [
				"ObjectFactory"
			]
		}
	},
	"AvailableRights": [
		"status-check"
	],
	"APIModules": {
		"statuscheck": {
			"class": "MediaWiki\\Extension\\StatusCheck\\Api\\StatusCheckEndpoint",
			"services": [
				"ObjectFactory"
			]
		}
	},
	"GroupPermissions": {
		"sysop": {
			"status-check": true
		}
	},
	"MessagesDirs": {
		"StatusCheck": [
			"i18n",
			"i18n/api"
		]
	},
	"ExtensionMessagesFiles": {
		"StatusCheckAlias": "StatusCheck.alias.php"
	},
	"ResourceModules": {
		"ext.statusCheck": {
			"localBasePath": "resources/ext.statusCheck",
			"remoteExtPath": "StatusCheck/resources/ext.statusCheck",
			"styles": [
				"init.css"
			]
		}
	},
	"manifest_version": 2
}
